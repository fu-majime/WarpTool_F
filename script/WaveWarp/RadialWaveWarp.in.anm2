--information:${EFFECT_NAME}@${PACKAGE_NAME} v${PACKAGE_VERSION} by ${AUTHOR}
--label:${SCRIPT_LABEL}
--group:基本設定,true
---$value:中心
local center = {0,0}
---$select:波形
---サイン=1
---矩形=2
---三角形=3
---のこぎり(正)=4
---のこぎり(負)=5
---円形=6
---半円形(正)=7
---半円形(負)=8
local shape = 1
---$track:周期[s], min = -1000, max = 1000, step = 0.01
local period = 8
--group:放射波,true
---$track:放射振幅[px], min = 0, max = 4000
local radAmp = 100
---$track:放射周波数[回], min = 0, max = 1000, step = 0.01
local radFreq = 8
---$track:放射位相[度], min = -3600, max = 3600
local radPhase = 0
--group:その他,false
---$value:PI
local PI = {}
obj.setanchor("center", 1)
--[[pixelshader@psmain:
---$include "RadialWaveWarp.hlsl"
]]
local function main()
    if type(PI.center) == "table" then
        center = {tonumber(PI.center[1]) or center[1], tonumber(PI.center[2]) or center[2]}
    end
    local current_period = tonumber(PI.period) or period
    local time_phase = current_period ~= 0 and obj.time / current_period or 0
    local ow, oh = obj.getpixel()
    local amplitude = tonumber(PI.radAmp) or radAmp
    if amplitude == 0 then return end
    local frequency = tonumber(PI.radFreq) or radFreq
    local phase = ((tonumber(PI.radPhase) or radPhase) / 360 + time_phase) * frequency
    local base_radius = math.max(ow, oh) * 0.5
    if base_radius <= 0 then return end
    -- 元の放射輪郭の補間係数はピクセルごとではなくフレームごとに計算。
    local n = math.max(1, math.abs(frequency))
    local inner = math.max(base_radius - amplitude, 0.000001)
    local outer = math.max(base_radius + amplitude, 0.000001)
    local angle = math.pi / n
    local tangent, straightness = 0, 0
    if n > 1 then
        tangent = (outer / inner - math.cos(angle)) / math.sin(angle)
        local limit = base_radius * (1 - math.cos(angle)) / (1 + math.cos(angle))
        straightness = math.min(math.abs(amplitude) / math.max(limit, 0.000001), 1)
    end
    local scale = math.abs(amplitude) / base_radius
    local pad_x = math.ceil((ow * 0.5 + math.abs(center[1])) * scale)
    local pad_y = math.ceil((oh * 0.5 + math.abs(center[2])) * scale)
    obj.effect("領域拡張", "上", pad_y, "下", pad_y, "右", pad_x, "左", pad_x)
    local w, h = obj.getpixel()
    obj.pixelshader("psmain", "object", {"object"}, {
        w, h, pad_x + ow * 0.5 + center[1], pad_y + oh * 0.5 + center[2],
        base_radius, amplitude, frequency, phase,
        tonumber(PI.shape) or shape, math.pi / (2 * n), tangent, straightness,
    }, "copy")
end
main()
