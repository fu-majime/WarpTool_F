--information:${EFFECT_NAME}@${PACKAGE_NAME} v${PACKAGE_VERSION} by ${AUTHOR}
--label:${SCRIPT_LABEL}
--group:基本設定,true
---$track:高さ[度], min = -3600, max = 3600, step = 0.01
local height = 90
---$track:幅[px], min = 0, max = 4000, step = 0.01
local width = 100
---$track:周期[s], min = -1000, max = 1000, step = 0.01
local period = 8
---$track:位相[度], min = -3600, max = 3600, step = 0.01
local phase = 0
---$value:中心
local center = {0,0}
---$check:アンカーで制御
local use_anchor = false
---$value:アンカー制御
local waveLayout = {100,0,0,0,0,0}

--group:波形,true
---$select:波形
---サイン=1
---矩形=2
---三角形=3
---のこぎり(正)=4
---のこぎり(負)=5
---円形=6
---半円形(正)=7
---半円形(負)=8
local shape = 1
---$track:基準位置[%], min = -100, max = 100
local basePosition = 0

--group:ランダム,false
---$track:高さランダム[%], min = 0, max = 100
local randHeight = 0
---$track:幅ランダム[%], min = 0, max = 100
local randWidth = 0
---$track:ランダム周期[s], min = -1000, max = 1000, step = 0.01
local randPeriod = 0
---$track:ランダムシード, min = -65536, max = 65535, step = 1
local randSeed = 0

--group:その他,false
---$value:PI
local PI = {}
if PI.use_anchor ~= nil then
    use_anchor = PI.use_anchor == true or (tonumber(PI.use_anchor) or 0) ~= 0
end
if use_anchor then obj.setanchor("waveLayout", 3, "line")
else obj.setanchor("center", 1) end
local WaveWarpCommon = require "WaveWarpCommon"

--[[pixelshader@psmain:
---$include "RotationWaveWarp.hlsl"
]]

local function parameters_from_layout(layout)
    local dx, dy = layout[1] - layout[3], layout[2] - layout[4]
    local radius = math.sqrt(dx * dx + dy * dy)
    local amplitude = radius == 0 and height
        or math.deg(math.atan2(dx, -dy))
    amplitude = amplitude + 360 * math.floor((height - amplitude) / 360 + 0.5)
    local phase_x, phase_y = layout[5] - layout[3], layout[6] - layout[4]
    local phase_distance = math.sqrt(phase_x * phase_x + phase_y * phase_y)
    local wavePhase = radius == 0 and phase
        or phase_distance / radius * 360
    return {amplitude, radius, wavePhase, layout[3], layout[4], basePosition}
end

local function layout_from_parameters(values)
    local amplitude = math.rad(values[1])
    local radius = math.max(0, values[2])
    local phase = radius * values[3] / 360
    local sine, cosine = math.sin(amplitude), math.cos(amplitude)
    return {
        values[4] + radius * sine, values[5] - radius * cosine,
        values[4], values[5],
        values[4] + phase, values[5],
    }
end

local function sync_controls()
    return WaveWarpCommon.syncControls(obj, global, {
        key = "rotationwavewarp_anchor:",
        injected = PI.use_anchor ~= nil,
        use_anchor = use_anchor,
        layout = waveLayout,
        values = {height, width, phase, center[1], center[2], basePosition},
        items = {
            {"高さ[度]", 1, -3600, 3600},
            {"幅[px]", 2, 0, 4000},
            {"位相[度]", 3, -3600, 3600},
            {"中心", 4},
            {"基準位置[%]", 6, -100, 100},
        },
        from_layout = parameters_from_layout,
        to_layout = layout_from_parameters,
    })
end

local function main()
    local committed, pending_layout = sync_controls()
    if committed then
        height, width, phase = committed[1], committed[2], committed[3]
        center = {committed[4], committed[5]}
        basePosition = committed[6]
    end
    if use_anchor then
        local layout = WaveWarpCommon.resolveLayout(pending_layout or waveLayout, PI.waveLayout)
        local values = parameters_from_layout(layout)
        height, width, phase = values[1], values[2], values[3]
        center = {values[4], values[5]}
        basePosition = values[6]
    end
    if type(PI.center) == "table" then
        center = {tonumber(PI.center[1]) or center[1], tonumber(PI.center[2]) or center[2]}
    end
    local current_period = tonumber(PI.period) or period
    local time_phase = current_period ~= 0 and obj.time / current_period or 0
    local ow, oh = obj.getpixel()
    local amplitude = math.rad(tonumber(PI.height) or height)
    local radius = tonumber(PI.width) or width
    if amplitude == 0 or radius <= 0 then return end
    local wavePhase = (tonumber(PI.phase) or phase) / 360 + time_phase
    local reference = math.max(-100, math.min(100, tonumber(PI.basePosition) or basePosition)) * 0.01
    -- 四隅の回転軌跡と最大移動量から必要な拡張量を求める。
    local ex, ey = ow * 0.5 + math.abs(center[1]), oh * 0.5 + math.abs(center[2])
    local extent = math.sqrt(ex * ex + ey * ey)
    local maximum_angle = math.abs(amplitude) * (1 + math.abs(reference))
    local displacement = 2 * extent * math.sin(math.min(maximum_angle, math.pi) * 0.5)
    local pad_x = math.ceil(math.min(displacement, extent + math.abs(center[1]) - ow * 0.5))
    local pad_y = math.ceil(math.min(displacement, extent + math.abs(center[2]) - oh * 0.5))
    obj.effect("領域拡張", "上", pad_y, "下", pad_y, "右", pad_x, "左", pad_x)
    local w, h = obj.getpixel()
    local random_period = tonumber(PI.randPeriod) or randPeriod
    local random_time = random_period ~= 0 and obj.time / random_period or 0
    local shader_seed = obj.rand(0, 2147483647, tonumber(PI.randSeed) or randSeed, 0)
    obj.pixelshader("psmain", "object", {"object"}, {
        w, h, pad_x + ow * 0.5 + center[1], pad_y + oh * 0.5 + center[2],
        amplitude, 1 / radius, wavePhase, tonumber(PI.shape) or shape, reference,
        tonumber(PI.randHeight) or randHeight, tonumber(PI.randWidth) or randWidth, shader_seed,
        random_time,
    }, "copy")
end
main()
