--information:${EFFECT_NAME}@${PACKAGE_NAME} v${PACKAGE_VERSION} by ${AUTHOR}
--label:${SCRIPT_LABEL}
--group:基本設定,true
---$track:高さ[px], min = 0, max = 4000
local height = 100
---$track:幅[px], min = 0, max = 4000
local width = 100
---$track:回転[度], min = -3600, max = 3600
local rot = 0
---$track:周期[s], min = -10, max = 10, step = 0.01
local period = 1
---$track:位相[度], min = -3600, max = 3600
local phase = 0
---$value:中心
local center = {0,0}
---$check:アンカーで制御
local use_anchor = false
---$value:アンカー制御
local waveLayout = {0,-100,0,0,100,0}

-- 方向波形ワープ共通UI
--group:波形,true
---$select:波形
---サイン=1
---矩形=2
---三角形=3
---のこぎり(正)=4
---のこぎり(負)=5
---円形=6
---半円形(正)=7
---半円形(負)=8
local shape = 1

---$check:鏡面反射
local mirror = 0

--group:ランダム,false
---$track:高さランダム[%], min = 0, max = 100
local randHeight = 0
---$track:幅ランダム[%], min = 0, max = 100
local randWidth = 0
---$track:ランダム周期[s], min = -1000, max = 1000, step = 0.01
local randPeriod = 0
---$track:ランダムシード, min = -65536, max = 65535, step = 1
local randSeed = 0

--group:その他,false
---$select:固定処理
---なし=1
---すべて=2
---上下=3
---左右=4
---上=5
---下=6
---左=7
---右=8
local fix = 1

---$track:フェード幅[px], min = 0, max = 1000
local fadePixel = 20
---$value:PI
local PI = {}

if PI.use_anchor ~= nil then
    use_anchor = PI.use_anchor == true
        or (tonumber(PI.use_anchor) or 0) ~= 0
end

if use_anchor then
    obj.setanchor("waveLayout", 3, "line")
else
    obj.setanchor("center", 1)
end
local WaveWarpCommon = require "WaveWarpCommon"

--[[pixelshader@psmain:
---$include "DirectionWaveWarp.hlsl"
]]

local function parameters_from_layout(layout)
    local dx, dy = layout[1] - layout[3], layout[2] - layout[4]
    local h = math.sqrt(dx * dx + dy * dy)
    local wx, wy = layout[5] - layout[3], layout[6] - layout[4]
    local w = h == 0 and math.sqrt(wx * wx + wy * wy)
        or math.abs(dx * wy - dy * wx) / h
    local r = h == 0 and rot or math.deg(math.atan2(dy, dx)) + 90
    r = r + 360 * math.floor((rot - r) / 360 + 0.5)
    return {h, w, r, layout[3], layout[4]}
end

local function layout_from_parameters(values)
    local s, c = math.sin(math.rad(values[3])), math.cos(math.rad(values[3]))
    return {
        values[4] + values[1] * s, values[5] - values[1] * c,
        values[4], values[5],
        values[4] + values[2] * c, values[5] + values[2] * s,
    }
end

local function sync_controls()
    return WaveWarpCommon.syncControls(obj, global, {
        key = "direction_wave_anchor:",
        injected = PI.use_anchor ~= nil,
        use_anchor = use_anchor,
        layout = waveLayout,
        values = {height, width, rot, center[1], center[2]},
        items = {
            {"高さ[px]", 1, 0, 4000},
            {"幅[px]", 2, 0, 4000},
            {"回転[度]", 3, -3600, 3600},
            {"中心", 4}
        },
        from_layout = parameters_from_layout,
        to_layout = layout_from_parameters,
    })
end

local function main()
    local committed, pending_layout = sync_controls()
    if committed then
        height, width, rot = committed[1], committed[2], committed[3]
        center = {committed[4], committed[5]}
    end
    if use_anchor then
        local layout = WaveWarpCommon.resolveLayout(pending_layout or waveLayout, PI.waveLayout)
        local dx, dy = layout[1] - layout[3], layout[2] - layout[4]
        height = math.sqrt(dx * dx + dy * dy)
        center = {layout[3], layout[4]}
        local wx, wy = layout[5] - center[1], layout[6] - center[2]
        if height == 0 then
            width = math.sqrt(wx * wx + wy * wy)
        else
            width = math.abs(dx * wy - dy * wx) / height
        end
        rot = math.deg(math.atan2(dy, dx)) + 90
    end

    local rot_rad = (tonumber(PI.rot) or rot) / 180 * math.pi
    local phase_normalized = ((tonumber(PI.phase) or phase) or 0) / 360
    
    local current_height = tonumber(PI.height) or height
    local current_width = tonumber(PI.width) or width
    if current_height == 0 or current_width == 0 then
        return
    end

    if type(PI.center) == "table" then
        local cx, cy = tonumber(PI.center[1]), tonumber(PI.center[2]);
        if cx and cy then
            center = { cx, cy };
        end
    end
    
    local orig_w, orig_h = obj.getpixel()

    mirror = tonumber(PI.mirror) or mirror
    local expansionParams = WaveWarpCommon.calculateExpansionParams(current_height, rot_rad, tonumber(PI.fix) or fix, mirror, center, orig_w, orig_h)
    obj.effect("領域拡張", "上", expansionParams[1], "下", expansionParams[2], 
               "右", expansionParams[3], "左", expansionParams[4])
    obj.cx = obj.cx + (expansionParams[4] - expansionParams[3]) * 0.5
    obj.cy = obj.cy + (expansionParams[1] - expansionParams[2]) * 0.5

    local w, h = obj.getpixel()
    
    local rotMatrix = WaveWarpCommon.createRotationMatrix(rot_rad)
    
    local topExpansion, bottomExpansion, rightExpansion, leftExpansion = 
        expansionParams[1], expansionParams[2], expansionParams[3], expansionParams[4]
    local originalCenterX = leftExpansion + orig_w * 0.5 + center[1]
    local originalCenterY = topExpansion + orig_h * 0.5 + center[2]
    
    local user_seed = tonumber(PI.randSeed) or randSeed
    local random_period = tonumber(PI.randPeriod) or randPeriod
    local random_time = random_period ~= 0 and obj.time / random_period or 0
    local shader_seed = obj.rand(0, 2147483647, user_seed, 0)
    
    local shaderParams = {
        w, h,
        orig_w, orig_h,
        center[1], center[2],
        originalCenterX, originalCenterY,
        obj.time,
        current_height,
        current_width,
        rot_rad,
        rotMatrix[1], rotMatrix[2], rotMatrix[3], rotMatrix[4],
        rotMatrix[1], -rotMatrix[2], -rotMatrix[3], rotMatrix[4],
        tonumber(PI.period) or period,
        tonumber(PI.shape) or shape or 1,
        phase_normalized,
        mirror,
        tonumber(PI.fix) or fix,
        tonumber(PI.fadePixel) or fadePixel,
        tonumber(PI.randHeight) or randHeight,
        tonumber(PI.randWidth) or randWidth,
        shader_seed,
        tonumber(PI.debug) or 0,
        random_time,
    }
    
    obj.pixelshader("psmain", "object", {"object"}, shaderParams, "copy")
end

main()
