--information:${EFFECT_NAME}@${PACKAGE_NAME} v${PACKAGE_VERSION} by ${AUTHOR}
--label:${SCRIPT_LABEL}
---$track:変形率, min = 0, max = 100
local ratio = 100
---$track:ピン数, min = 0, max = 20, step = 1
local pins = 3
---$select:変形方式
---MLS=1
---ARAP=2
local deformationMethod = 2
---$track:メッシュ密度, min = 5, max = 50, step = 1
local density = 15
---$track:分割数, min = 1, max = 10, step = 1
local div = 3
---$track:硬さ, min = 0.01, max = 2, step = 0.01
local stiff = 1
--hide@stiff:deformationMethod==2
---$check:ピン止め操作
local edit_source = false
--group:詳細設定,false
---$track:しきい値, min = 0, max = 255, step = 1
local threshold = 1
---$track:縁取り膨張, min = 0, max = 100, step = 1
local border = 0
---$check:表示
local show = true
---$value:ピン元
local src = {}
---$value:ピン先
local dst = {}
---$value:ピン種類
local pin_types = {}
---$value:ボーン親子関係
local bone_forest = {}

-- ピン種類はピン元ID（srcの1始まりのインデックス）に対応する数値配列で保持する。
-- 保存値を数値に限定し、処理側では名前付き定数を使って種類を判定する。
local PIN_TYPE = {
	POSITION = 0, -- 位置ピン
	BONE     = 1, -- ボーンピン
	BEND     = 2, -- ベンドピン
	DETAIL   = 3, -- 詳細ピン
	STARCH   = 4, -- スターチピン
	OVERLAP  = 5, -- 重なりピン
}

-- 未設定・不正な値は位置ピンとして扱う。ピン数を増減しても既存の種類は維持する。
local normalized_pin_types = {}
for pin_id = 1, pins do
	local pin_type = type(pin_types) == "table" and pin_types[pin_id] or nil
	if type(pin_type) ~= "number"
		or pin_type ~= math.floor(pin_type)
		or pin_type < PIN_TYPE.POSITION
		or pin_type > PIN_TYPE.OVERLAP then
		pin_type = PIN_TYPE.POSITION
	end
	normalized_pin_types[pin_id] = pin_type
end
pin_types = normalized_pin_types

-- bone_forest format: { tree, tree, ... }
-- tree format:        { bone_pin_id, child_tree, child_tree, ... }
-- ボーンピン（pin_types[id] == PIN_TYPE.BONE）のIDだけをノードに使用する。

-- GUIでこの効果を編集中のときだけ、ネイティブエディター用に変形前画像を保持する。
-- aux2が未導入でもスクリプト本体は従来どおり動作する。
if obj.getoption("gui") then
	pcall(function()
		obj.effect("WarpTool_F Internal Puppet Capture")
	end)
end

-- RGBA加算合成でα値が1.0を超えた場合に調整するPixelShader
--[[pixelshader@psmain:
---$include "PuppetTool.hlsl"
]]

---$include "PuppetPinHierarchy.inc.lua"

obj.effect("領域拡張", "上", 1, "下", 1, 
        "右", 1, "左", 1)
local w, h = obj.getpixel()
local hw, hh = w * 0.5, h * 0.5

local module_ok, mesh_module = pcall(function()
	return obj.module("puppet_geometry")
end)
---$include "PuppetPins.inc.lua"
---$include "PuppetMesh.inc.lua"
---$include "PuppetDeformation.inc.lua"
---$include "PuppetRendering.inc.lua"
-- =============================================================
-- 8. バッファ処理
-- =============================================================
obj.clearbuffer("object", dstw, dsth)
obj.pixelshader("psmain", "object", "tempbuffer")
obj.cx = obj.cx - sx_off
obj.cy = obj.cy - sy_off
obj.setoption("focus_mode", "fixed_size")
